  "proof": {
    "fixedLayout": "greedily pack next complete word whenever it fits; spaces created only before successfully appended words, never leading/trailing/padding columns",
    "sparseRecurrence": "f(row,c)=1+max previous-row f atc−1,c,c+1; no prior space means1. Empty current row replaces previous by empty and cuts all chains.",
    "linearMerge": "current/previous columns increasing; left pointer never returns; each [c−1,c+1] contains<=3 distinct integer columns; total space states<N",
    "nextChange": "each nonfinal current row first excluded word requiresq_i=used+1+nextLength>w; q=minq_i. Forw<=wprime<q, inductively every row has same start/end and same internal columns.",
    "rowCountMonotone": "greedy reaches at least as far afterjrows as any other feasible packing: if alternative endpoint not already passed, its remaining suffix from the greedy previous endpoint also fits. Hence greedy minimizes rows; increasing width preserves all old row feasibility.",
    "earlyStop": "future river<=future rows<=current rows. If best>=current rows no strict improvement possible; larger equal width loses tie.",
    "finiteDomain": "T=sumLengths+N−1 puts all words on one row; beyondT no internal space column changes",
    "tie": "evaluate candidate widths increasing, update only on strict length improvement; skipped layouts identical and future stopped candidates no shorter",
