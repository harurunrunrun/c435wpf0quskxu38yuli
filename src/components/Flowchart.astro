---
import { renderFlowHtml } from '../lib/flow';
import { techniques } from '../lib/content';
const titles = Object.fromEntries(techniques.map((technique) => [technique.id, technique.title]));
const html = renderFlowHtml(import.meta.env.BASE_URL, titles);
---

<Fragment set:html={html} />

<script>
  import '../lib/flow-client';
</script>

<style is:global>
.flowchart{--flow-node-bg:#fff;--flow-node-border:#aaa;--flow-result-bg:#f8fafc;--flow-route-bg:#f8fafc;--flow-text:#222;--flow-muted:#555;--flow-link:#1754a4;margin-block:1.2rem}
:root[data-theme='dark'] .flowchart{--flow-node-bg:#222;--flow-node-border:#777;--flow-result-bg:#282e36;--flow-route-bg:#282e36;--flow-text:#eee;--flow-muted:#bbb;--flow-link:#8dbbff}
.flowchart [hidden]{display:none!important}.flowchart button,.flowchart select,.flowchart input{font:inherit}.flowchart button{color:var(--sl-color-text,#222);background:var(--sl-color-bg,#fff);border:1px solid var(--sl-color-gray-5,#bbb);border-radius:2px;padding:.45rem .7rem;min-height:2.5rem;cursor:pointer;line-height:1.6}.flowchart button:hover:not(:disabled){background:var(--sl-color-bg-sidebar,#f7f7f7);border-color:#1754a4}.flowchart button:disabled{opacity:.45;cursor:default}.flowchart button:focus-visible,.flowchart select:focus-visible,.flowchart input:focus-visible,.flow-svg-viewport:focus-visible{outline:2px solid #1754a4;outline-offset:3px}.flow-toolbar{display:flex;gap:.6rem;flex-wrap:wrap;align-items:end;padding:.7rem 0;border-bottom:1px solid #ddd}.flow-select-label{display:flex;flex-direction:column;gap:.2rem;font-size:.9rem}.flowchart select{color:var(--sl-color-text,#222);background:var(--sl-color-bg,#fff);border:1px solid #bbb;border-radius:2px;min-height:2.5rem;padding:.4rem .5rem;max-width:100%}.flow-view-buttons,.flow-action-buttons{display:flex;flex-wrap:wrap;gap:.35rem}.flow-action-buttons{margin-inline-start:auto}.flowchart button[aria-pressed='true']{border-color:#1754a4;color:var(--sl-color-accent-high,#1754a4);font-weight:600}.flow-live{min-height:1.4em;font-size:.85rem;color:var(--sl-color-gray-2,#555);margin-block:.5rem!important}.flow-question-panel{padding:.7rem 0 1rem}.flow-question-panel h3{margin-block:.5rem .7rem!important;font-size:1.2rem}.flow-question-panel h4{margin-block:1.2rem .5rem!important}.flow-kicker,.flow-note{font-size:.88rem;color:var(--sl-color-gray-2,#555)}.flow-answer-buttons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin-block:1rem}.flow-answer-buttons button{text-align:left;padding:.65rem .8rem}.flow-candidate-list{padding-left:1.4rem!important}.flow-candidate-list li{margin-block:.4rem!important}.flow-history{border-top:1px solid #ddd;margin-block-start:1rem;padding-block-start:.7rem}.flowchart summary{cursor:pointer;font-size:.9rem}.flow-history button{text-align:start;font-size:.88rem;width:100%}.flow-history li{margin-block:.4rem}.flow-share{margin-block:.7rem}.flow-share label{display:block;font-size:.88rem}.flow-share input{display:block;width:100%;border:1px solid #bbb;border-radius:2px;padding:.5rem;background:var(--sl-color-bg,#fff);color:var(--sl-color-text,#222)}.flow-camera-controls{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;margin-block:.7rem}.flow-camera-controls button{padding:.35rem .5rem;font-size:.85rem}.flow-pan-buttons{display:flex;gap:.2rem}.flow-zoom-value{font-size:.85rem;color:var(--sl-color-gray-2,#555);margin-inline-start:auto}.flow-svg-viewport{border:1px solid #bbb;background:var(--sl-color-bg,#fff);overflow:auto;width:100%;max-height:680px}.flow-svg-viewport svg{display:block;max-width:none}.flowchart[data-enhanced='true'] .flow-svg-viewport{overflow:hidden;height:clamp(380px,65vh,680px);touch-action:none;cursor:grab}.flowchart[data-enhanced='true'] .flow-svg-viewport.is-dragging{cursor:grabbing}.flowchart[data-enhanced='true'] .flow-svg-viewport svg{width:100%;height:100%;min-width:0}.flow-svg-viewport svg a{cursor:pointer}.flow-diagram-help{font-size:.88rem;color:var(--sl-color-gray-2,#555)}.flow-diagram-help a{margin-inline-start:.7rem;white-space:nowrap}.flow-node-list{padding:.7rem 0}.flow-node-list>ol>li{padding-block:.7rem;border-bottom:1px solid #ddd}.flow-node-list li p,.flow-node-list li ul{font-size:.9rem}.flow-domain-nav{display:flex;flex-wrap:wrap;gap:.35rem 1rem;margin-block:0 1rem}.flow-domain-nav a{font-size:.95rem;padding:.25rem 0}.flow-domain-nav a[aria-current]{font-weight:600;text-decoration-thickness:2px}.flow-static-nav{display:grid;gap:.4rem;margin-block:1rem}.flow-static-nav details>div{display:flex;flex-wrap:wrap;gap:.4rem;padding-block:.4rem}.flow-static-nav a{padding:.25rem .4rem;font-size:.9rem}@media(max-width:650px){.flow-select-label{width:100%}.flow-action-buttons{margin-inline-start:0}.flow-view-buttons{width:100%}.flow-view-buttons button{flex:1}.flow-answer-buttons{grid-template-columns:1fr}.flow-zoom-value{display:none}.flow-pan-buttons{margin-inline-start:auto}}
</style>

